{
  "name": "dsh-session-team",
  "version": "0.0.1",
  "private": true,
  "description": "DeepSeek Harness 插件：按项目把多个 session 组织成 agent 团队，一个 Lead 派活、按阶段收汇报，并支持从零建队与中断恢复。",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "agent-team",
    "multi-agent",
    "orchestration"
  ],
  "author": "Ronnie-Young",
  "scripts": {
    "test": "node --test --test-timeout=30000 test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ronnie-Young/dsh-session-team.git"
  },
  "homepage": "https://github.com/Ronnie-Young/dsh-session-team#readme",
  "bugs": {
    "url": "https://github.com/Ronnie-Young/dsh-session-team/issues"
  }
}
